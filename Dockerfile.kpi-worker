FROM node:22-slim

WORKDIR /app

# The worker needs the full source tree because the TypeScript build bundles the parser,
# database code, and aggregate-analysis logic. The patches directory must be present
# before pnpm installs the project's patched dependency.
COPY . .
RUN npm install -g corepack@latest \
  && corepack pnpm install --frozen-lockfile \
  && corepack pnpm exec esbuild server/kpiImportWorker.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/kpiImportWorker.js

ENV NODE_ENV=production \
    KPI_IMPORT_WORKER_MODE=1

CMD ["node", "dist/kpiImportWorker.js"]
