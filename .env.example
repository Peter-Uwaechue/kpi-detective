# Dashboard API and dedicated KPI import worker
# Do not commit real credentials. Configure these values separately in the dashboard host and worker host.

DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/kpi_detective

# S3-compatible object storage. Cloudflare R2, AWS S3, or another compatible private bucket may be used.
KPI_S3_BUCKET=kpi-detective-imports
KPI_S3_REGION=auto
KPI_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
KPI_S3_ACCESS_KEY_ID=
KPI_S3_SECRET_ACCESS_KEY=
KPI_S3_PREFIX=kpi-imports

# Worker controls. The worker consumes queued jobs and streams each source in batches.
KPI_IMPORT_BATCH_SIZE=1000
KPI_IMPORT_WORKER_POLL_MS=5000
KPI_IMPORT_WORKER_MODE=1

